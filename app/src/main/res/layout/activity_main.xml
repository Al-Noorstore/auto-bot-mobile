<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#212121">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- NATIVE POWERS PANEL (site sidebar se khulta hai) -->
    <ScrollView
        android:id="@+id/nativeScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#212121"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <Button
                android:id="@+id/btnCloseNative"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="← Wapas"
                android:textColor="#10a37f"
                android:background="#2f2f2f"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ Native Powers"
                android:textColor="#10a37f"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Real contact book, direct calls, WhatsApp"
                android:textColor="#9b9b9b"
                android:textSize="13sp"
                android:layout_marginBottom="20dp" />

            <EditText
                android:id="@+id/inputName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Naam (e.g. Ali Khan)"
                android:textColorHint="#6b6b6b"
                android:textColor="#ececec"
                android:inputType="textPersonName"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/inputPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Number (e.g. +923001234567)"
                android:textColorHint="#6b6b6b"
                android:textColor="#ececec"
                android:inputType="phone"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnSaveContact"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="💾 Phone Contact Book Mein Save Karo"
                android:textColor="#ececec"
                android:background="#2f2f2f"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnAutoCall"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="📞 Auto Call (bina dialer ke)"
                android:textColor="#ececec"
                android:background="#2f2f2f"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnWhatsApp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="💬 WhatsApp Chat Kholo"
                android:textColor="#ececec"
                android:background="#2f2f2f"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ready"
                android:textColor="#10a37f"
                android:textSize="13sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
