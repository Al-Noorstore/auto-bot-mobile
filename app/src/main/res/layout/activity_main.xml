<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F14">

    <!-- MAIN: Auto Bot website UI (chat, tasks, contacts, rules, memory) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#10161F"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🤖 AUTO BOT v1.3"
                android:textColor="#22D3EE"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnNative"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="📱 Native"
                android:textColor="#22D3EE"
                android:textSize="13sp"
                android:background="#1F2937"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />
        </LinearLayout>

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

    <!-- NATIVE PANEL: mobile powers -->
    <ScrollView
        android:id="@+id/nativePanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0B0F14"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🤖 AUTO BOT"
                android:textColor="#22D3EE"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mobile Command Center v1.3"
                android:textColor="#8B98A9"
                android:textSize="14sp"
                android:layout_marginBottom="20dp" />

            <Button
                android:id="@+id/btnBackWeb"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="← Dashboard pe wapas"
                android:textColor="#22D3EE"
                android:background="#1F2937"
                android:layout_marginBottom="20dp" />

            <EditText
                android:id="@+id/inputName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Naam (e.g. Ali Khan)"
                android:textColorHint="#5B6675"
                android:textColor="#E6EDF3"
                android:inputType="textPersonName"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/inputPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Number (e.g. +923001234567)"
                android:textColorHint="#5B6675"
                android:textColor="#E6EDF3"
                android:inputType="phone"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnSaveContact"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="💾 Contact Book Mein Save Karo"
                android:textColor="#E6EDF3"
                android:background="#1F2937"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnAutoCall"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="📞 Auto Call (bina dialer ke)"
                android:textColor="#E6EDF3"
                android:background="#1F2937"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnWhatsApp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="💬 WhatsApp Chat Kholo"
                android:textColor="#E6EDF3"
                android:background="#1F2937"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ready"
                android:textColor="#34D399"
                android:textSize="13sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
